{
  "version": 2,
  "name": "dw-dropbox-oauth-service",
  "public": true,
  "routes": [
    {
      "src": "/api/oauth/connect",
      "dest": "/api/oauth/connect"
    },
    {
      "src": "/api/oauth/callback",
      "dest": "/api/oauth/callback"
    },
